{
  "mqtt": {
    "host": "homeassistant.local",
    "port": 1883,
    "username": "mqtt",
    "password": "PUT-THE-PASSWORD-HERE",
    "tls": false,
    "tls_insecure": false,
    "ca_file": null,
    "client_id": "xpeng-mac-bridge",
    "keepalive": 60,
    "topic_prefix": "xpeng",
    "discovery_prefix": "homeassistant",
    "discovery": true,
    "publish_interval": 30
  },
  "source": {
    "database": null,
    "uid": null,
    "vin": null,
    "enrich_from_plist": true,
    "plist_path": null,
    "refresh_app": true,
    "refresh_after_seconds": 3600,
    "refresh_driving_after_seconds": 60,
    "refresh_charging_after_seconds": 300,
    "refresh_wait_seconds": 150,
    "app_name": "XPENG"
  },
  "behaviour": {
    "retain": true,
    "qos": 1,
    "stale_after_seconds": 4200,
    "publish_raw_state": true,
    "prune_removed_entities": true,
    "state_file": null,
    "reset_settle_seconds": 20
  },
  "logging": {
    "level": "INFO"
  }
